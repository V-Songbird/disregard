{
  // Static assets and the single-rule scoring endpoint.
  "name": "disregard-score",
  "main": "worker.js",
  "compatibility_date": "2026-09-20",

  // The page. Assets are matched first, so the Worker only ever sees
  // /api/score and typos.
  "assets": { "directory": "./public" },

  // The public hostname, declared here so every deploy keeps it. With routes
  // present Wrangler turns workers.dev off unless it is set explicitly.
  "routes": [{ "pattern": "disregard.dev", "custom_domain": true }],
  "workers_dev": true,

  // Serve only deployed versions: preview URLs would make every uploaded
  // version public, including any without the rate limits below. Only
  // `wrangler deploy` and `wrangler triggers deploy` apply this setting.
  "preview_urls": false,

  // Approximate request protection within each Cloudflare location, not a
  // global budget. The anonymous client quota is shared by users on one IP.
  // Namespace IDs are non-secret account-wide identifiers; keep them unique
  // unless sharing counters with another Worker is intentional.
  "ratelimits": [
    {
      "name": "SCORE_CLIENT_LIMITER",
      "namespace_id": "930021",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "SCORE_AGGREGATE_LIMITER",
      "namespace_id": "930022",
      "simple": { "limit": 180, "period": 60 }
    }
  ],

  // TYPESAFE_API_KEY is a secret, not a var: it must never be in this file.
  //   wrangler secret put TYPESAFE_API_KEY

  // Workers Logs keeps errors and console output (the code writes one
  // { code, status } error per 5xx response), but no per-request invocation
  // logs: those would store each caller's IP address and location, which the
  // privacy page does not list. Traces stay off.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
